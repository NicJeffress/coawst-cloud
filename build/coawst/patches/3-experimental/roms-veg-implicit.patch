+          cff4=0.0_r8
+          DO k=1,N(ng)
+            cff=0.5_r8*(Hz(i,j-1,k)+Hz(i,j,k))
+            cff1=cff1+VEG(ng)%cv_veg(i,j,k)
+            cff2=cff2+VEG(ng)%cv_veg(i,j,k)*v(i,j,k,nrhs)
+            cff3=cff3+cff*v(i,j,k,nrhs)
+            cff4=cff4+cff
+          END DO
+          cff3=cff3/cff4
+          cff5=cff1
+          IF (ABS(cff3).gt.1.0E-4_r8) THEN
+            cff6=cff2/cff3
