+     &                   z_w(i,j-1,k-1)-z_w(i,j,k-1))
+            bi_hu=bi_hu+bi_r*v(i,j,k,nrhs)
+            bi_h=bi_h+bi_r
+          END DO
+          bi_hu=bi_hu/bi_h
+          FORCES(ng)%kbv(i,j)=bi_k
+          FORCES(ng)%c2bv(i,j)=0.0_r8
+          IF (ABS(bi_hu).gt.1.0E-4_r8) THEN
+            bi_r=bi_k*v(i,j,1,nrhs)/bi_hu
+            IF (bi_r.gt.0.0_r8) FORCES(ng)%c2bv(i,j)=MIN(bi_r,2.0_r8*bi_k)
+          END IF
+          FORCES(ng)%rbv(i,j)=bvstr(i,j)-FORCES(ng)%c2bv(i,j)*bi_hu
+        END DO
