+#ifdef BSTRESS_IMPLICIT
+!
+!-----------------------------------------------------------------------
+!  Implicit bottom stress (BSTRESS_IMPLICIT): drag coefficient of the
+!  bottom layer, kbu = Tauc/|U_1| (m/s; Tauc the current stress magnitude,
+!  |U_1| the bottom-layer speed, both at the face; a quadratic drag along
+!  the bottom-layer flow; not |bustr|/|u_1|, which is unbounded where u_1
+!  alone is near zero). Barotropic mode: implicit part c2bu*ubar with
+!  c2bu = kbu*u_1/ubar where u_1 and ubar (the depth mean now) agree in
+!  sign (at most 2 kbu), 0 where they oppose or ubar is tiny, plus the
+!  explicit remainder rbu = bustr - c2bu*ubar (rhs3d, frozen), so the
+!  barotropic mode feels exactly bustr at the start of each step. (A
+!  first version used kbu where they opposed: the wrong sign under the
+!  undertow at the crest's seaward edge, ~7 % of faces on A15.)
+!-----------------------------------------------------------------------
+!
+      DO j=Jstr,Jend
