+     &                  v(i-1,j+1,1,nrhs)+v(i,j+1,1,nrhs))
+          bi_k=0.5_r8*(Tauc(i-1,j)+Tauc(i,j))/                         &
+     &         MAX(SQRT(u(i,j,1,nrhs)**2+bi_r**2),1.0E-4_r8)
+          bi_hu=0.0_r8
+          bi_h=0.0_r8
