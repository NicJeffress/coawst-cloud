+      IF (KREPTX.EQ.0 .OR. OPTG.NE.3) THEN
+         CALL CVMSH1 (XP, YP, XC, YC, KGRPNT, XCGRID, YCGRID, KGRBND)
+         RETURN
+      ENDIF
