+!-----------------------------------------------------------------------
+!  Wave streaming force inside the canopy (Luhar et al. 2010): the wave
+!  momentum lost to the plants, Dissip_veg k/sigma (m2/s2 after the
+!  coupler's division by rho0), is given to the mean flow in the canopy
+!  layers. coawst-cloud patch roms-veg-streaming-fixes: each layer gets
+!  the share of the canopy's frontal area in it (Cd D n times the layer
+!  thickness inside the canopy), so that the force integrates over depth
+!  to Dissip_veg k/sigma. Before, every canopy layer received the full
+!  Dissip_veg k/sigma times its canopy fraction (the depth integral was
+!  that value times the canopy height in metres); the canopy fraction was
+!  taken from vegetation_drag before it ran in the step (the previous
+!  step's value, and zero after a restart); and the force was computed
+!  on interior points only, although wec_streaming averages it to u- and
+!  v-points with the neighbouring points. The canopy height here is the
+!  rigid height (VEG_FLEX bending is not applied).
+!-----------------------------------------------------------------------
+!
+      DO j=Jstr-1,Jend+1
+        DO i=Istr-1,Iend+1
+          Dstp=z_w(i,j,N(ng))-z_w(i,j,0)
+          waven=2.0_r8*pi/MAX(Lwave(i,j),Lwave_min)
+          cff1=1.5_r8*pi-Dwave(i,j)-angler(i,j)
+          wavenx=waven*COS(cff1)
+          waveny=waven*SIN(cff1)
+          sigma=MIN(SQRT(g*waven*TANH(waven*Dstp)),2.0_r8)
+          osigma=1.0_r8/sigma
+!
+!  Frontal area of the canopy in each layer.
+!
+          wsum=0.0_r8
+          DO k=1,N(ng)
+            wk(k)=0.0_r8
+            DO iveg=1,NVEG
+              cff=plant(i,j,iveg,isHght)-(z_w(i,j,k-1)-z_w(i,j,0))
+              frac=MAX(0.0_r8,MIN(cff/Hz(i,j,k),1.0_r8))
+              wk(k)=wk(k)+CD_VEG(iveg,ng)*plant(i,j,iveg,isDiam)*       &
+     &                    plant(i,j,iveg,isDens)*frac*Hz(i,j,k)
+            END DO
+            wsum=wsum+wk(k)
+          END DO
+!
+          cff2=0.0_r8
+          IF (wsum.gt.0.0_r8) cff2=dissip_veg(i,j)*osigma/wsum
+          DO k=1,N(ng)
+            cff=cff2*wk(k)/Hz(i,j,k)
+            BWDXL_veg(i,j,k)=cff*wavenx
+            BWDYL_veg(i,j,k)=cff*waveny
+          END DO
         END DO
       END DO
 !
